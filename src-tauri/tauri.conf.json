{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shellink",
  "version": "0.2.4",
  "identifier": "com.shellink.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "shellink",
        "width": 1400,
        "height": 918,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "label": "main",
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
