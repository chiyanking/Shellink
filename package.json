{
  "name": "shellink",
  "private": true,
  "version": "0.2.4",
  "description": "A Go CLI and daemon for SSH, local PTY sessions, file transfer, and remote editing — built for AI agents and humans alike.",
  "license": "MIT",
  "homepage": "https://github.com/jie123108/Shellink#readme",
  "bugs": {
    "url": "https://github.com/jie123108/Shellink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jie123108/Shellink.git"
  },
  "workspaces": [
    "protocol",
    "client",
    "cli",
    "server",
    "web",
    "plugin-dsh"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run dev:server & npm run dev:web & wait",
    "dev:server": "go run ./cmd/shellink server run",
    "dev:server:typescript": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build:runtime": "npm run build:go",
    "build:typescript:runtime": "npm run build --workspace=web && node scripts/embed-web.mjs && npm run build --workspace=protocol && npm run build --workspace=client && npm run build --workspace=server && npm run build --workspace=cli && npm run build --workspace=plugin-dsh",
    "build:go": "node scripts/build-go.mjs",
    "build:client": "npm run build --workspace=client",
    "test:client": "npm run test --workspace=client",
    "test:plugin-dsh": "npm run test --workspace=plugin-dsh",
    "build": "npm run build:go",
    "build:binary": "npm run build:binary:current",
    "build:binary:current": "npm run build:go",
    "build:binary:macos-arm64": "node scripts/build-go.mjs --target darwin arm64",
    "build:binary:macos-x64": "node scripts/build-go.mjs --target darwin amd64",
    "build:binary:linux-arm64": "node scripts/build-go.mjs --target linux arm64",
    "build:binary:linux-x64": "node scripts/build-go.mjs --target linux amd64",
    "build:binary:windows-arm64": "node scripts/build-go.mjs --target windows arm64",
    "build:binary:windows-x64": "node scripts/build-go.mjs --target windows amd64",
    "build:binary:all": "node scripts/build-go.mjs --all",
    "start": "go run ./cmd/shellink server run",
    "test:server": "npm run test --workspace=server",
    "test:server:coverage": "npm run test:coverage --workspace=server",
    "test:protocol": "npm run test --workspace=protocol"
  }
}
